+                    logger.warning(
+                        "RFork seed port exceeds 65535: base=%d global_rank=%d model_kind=%s resolved_port=%d; "
+                        "falling back to an OS-assigned port",
+                        self.config.seed_port_base,
+                        self.identity.global_rank,
