+        revision=revision,
+        max_model_len=max_model_len,
+        max_seq_len_to_capture=max_seq_len_to_capture,
+        runner_type=runner_type,
+        task=task,
+        convert=convert,
+        use_mla=use_mla,
+        enforce_eager=enforce_eager,
